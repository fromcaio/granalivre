////////////////////////////////////////////////////////
// BANCO DE DADOS - GESTÃO FINANCEIRA (VERSÃO FINAL EM PORTUGUÊS)
////////////////////////////////////////////////////////

Table usuarios {
  id integer [primary key, increment]
  email varchar [unique, not null]
  senha_hash varchar [not null]
  criado_em timestamp [default: `now()`]
}

////////////////////////////////////////////////////////
// CONTAS BANCÁRIAS
////////////////////////////////////////////////////////
Table contas {
  id integer [primary key, increment]
  usuario_id integer [not null]
  nome varchar [not null] // Ex: Nubank, Itaú, Carteira Física
  //saldo decimal(12,2) [default: 0.00]
  agencia varchar [not null]
  numero varchar [not null] 
  criado_em timestamp [default: `now()`]
}

////////////////////////////////////////////////////////
// TRANSAÇÕES UNIFICADAS (ENTRADAS, SAÍDAS, TRANSFERÊNCIAS, ETC.)
////////////////////////////////////////////////////////
Table transacoes {
  id integer [primary key, increment]
  nome varchar [not null]
  usuario_id integer [not null]
  conta_id integer [not null]
  tipo varchar [not null, note: 'entrada | saida']
  valor decimal(10,2) [not null, note: 'Valor positivo (entrada) ou negativo (saída)']
  descricao text
  //categoria varchar [note: 'Ex: Mercado, Salário, Lazer']
  //metodo_pagamento varchar [note: 'PIX, Débito, Crédito, etc.']
  data date [not null]
  criado_em timestamp [default: `now()`] 
}

////////////////////////////////////////////////////////
// AUTOMAÇÕES (REGRAS DE TRANSAÇÕES RECORRENTES)
////////////////////////////////////////////////////////
Table automacoes {
  id integer [primary key, increment]
  usuario_id integer [not null]
  conta_id integer [not null]
  nome varchar [not null] // Ex: Salário, Conta de Luz
  tipo varchar [not null, note: 'entrada | saida']
  valor decimal(10,2) [not null]
  frequencia varchar [not null, note: 'mensal | semanal | anual']
  dia_do_mes integer [note: 'Dia do mês (1–31)']
  categoria varchar
  descricao text
  ativo boolean [default: true]
  criado_em timestamp [default: `now()`]
}

////////////////////////////////////////////////////////
// INVESTIMENTOS
////////////////////////////////////////////////////////
Table investimentos {
  id integer [primary key, increment]
  valor_original decimal(10,2)
  usuario_id integer [not null]
  nome_ativo varchar [not null]
  quantidade integer 
  classe_ativo varchar [not null, note: 'Ex: Ação, FII, Renda Fixa']
  preco_unitario decimal(10,2) 
  data_compra date [not null]
  data_vencimento date
  tipo_de_rentabilidade varchar [not null, note: 'Ex: Variável, Prefixado']
  status varchar [default: 'ativo', note: 'ativo | vendido | encerrado']
  criado_em timestamp [default: `now()`]
}

////////////////////////////////////////////////////////
// PATRIMÔNIOS
////////////////////////////////////////////////////////
Table patrimonios {
  id integer [primary key, increment]
  usuario_id integer [not null]
  nome varchar [not null]
  data_aquisicao date [not null]
  valor_original decimal(10,2) [not null]
  variacao_anual_percent decimal(5,2)
  tipo varchar [note: 'Ex: casa, carro, apartamento']
  manutencao_mensal decimal(10,2)
  descricao text
  criado_em timestamp [default: `now()`]
}

////////////////////////////////////////////////////////
// RELAÇÕES ENTRE TABELAS
////////////////////////////////////////////////////////
Ref: contas.usuario_id > usuarios.id

Ref: transacoes.usuario_id > usuarios.id
Ref: transacoes.conta_id > contas.id

Ref: automacoes.usuario_id > usuarios.id
Ref: automacoes.conta_id > contas.id

Ref: investimentos.usuario_id > usuarios.id

Ref: patrimonios.usuario_id > usuarios.id
     